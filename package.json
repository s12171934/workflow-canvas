{
  "name": "workflow-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local graph canvas for designing workflows and observing Orca tasks.",
  "engines": { "node": ">=22" },
  "bin": { "workflow-canvas": "bin/workflow-canvas" },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "start": "tsx server/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test src/model.test.ts server/*.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
