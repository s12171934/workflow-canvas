{
  "name": "workflow-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local graph canvas for designing workflows and observing Orca tasks.",
  "engines": { "node": ">=22" },
  "bin": { "workflow-canvas": "bin/workflow-canvas" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "./bin/workflow-canvas",
    "check": "tsc --noEmit && scripts/cargo check --workspace",
    "build": "node scripts/build-rust.mjs && tsc --noEmit && vite build",
    "test": "node scripts/build-rust.mjs --dev && tsx --test src/model.test.ts src/layout.test.ts src/routing.test.ts tests/compat/*.test.ts tests/*.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "tsx": "^4.0.0"
  }
}
