{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/s12171934/workflow-canvas/exports/workflow.schema.json",
  "title": "Workflow Canvas v1",
  "type": "object",
  "required": ["version", "id", "name", "description", "runId", "nodes", "edges"],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 500 },
    "description": { "type": "string", "maxLength": 10000 },
    "runId": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/id" }] },
    "nodes": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "required": ["id", "type", "position", "data"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "type": { "const": "stage" },
          "position": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
          "data": {
            "type": "object", "required": ["label", "description", "kind"],
            "properties": {
              "label": { "type": "string", "maxLength": 500 },
              "description": { "type": "string", "maxLength": 20000 },
              "kind": { "enum": ["task", "gate", "note"] },
              "taskId": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/id" }] }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array", "maxItems": 2000,
      "items": {
        "type": "object", "required": ["id", "source", "target"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "source": { "$ref": "#/$defs/id" }, "target": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "maxLength": 500 }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" } }
}
