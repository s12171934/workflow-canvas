#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for arg in "$@"; do
  if [ "$arg" = '--dev' ]; then exec node "$root/scripts/dev.mjs" "$@"; fi
  if [ "$arg" = '--help' ]; then
    echo 'workflow-canvas [--dev] [--port <port>]'
    echo 'Local Orca graph canvas; binds to 127.0.0.1.'
    exit 0
  fi
done
binary="$root/.local/target/release/workflow-canvas"
if [ ! -x "$binary" ] || [ ! -f "$root/dist/index.html" ]; then
  echo '빌드가 필요합니다. npm run build를 먼저 실행하세요.' >&2
  exit 1
fi
exec "$binary" --root "$root" "$@"
